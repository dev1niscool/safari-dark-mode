{
  "manifest_version": 3,
  "name": "Safari Dark Mode",
  "short_name": "Dark Mode",
  "version": "1.0.0",
  "description": "Turns light websites dark while leaving websites that are already dark alone.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "Safari Dark Mode",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "dark-mode.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  }
}
